{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "greenhouse-mote",
	"main": "src/index.ts",
	"compatibility_date": "2026-03-10",
	"observability": {
		"enabled": true
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "database",
			"database_name": "greenhouse-mote",
			"database_id": "00000000-1111-2222-3333-444444444444",
			"remote": false
		}
	],
	"vars": {
		"ACCOUNT_ID": "012345678901234567890123456789012"
	}
}

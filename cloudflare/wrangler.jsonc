{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "greenhouse-mote",
	"main": "src/index.ts",
	"compatibility_date": "2026-03-10",
	"observability": {
		"enabled": true
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"analytics_engine_datasets": [
		{
			"binding": "RECORDS",
			"dataset": "records"
		}
	],
	"vars": {
		"ACCOUNT_ID": "012345678901234567890123456789012"
	}
}
